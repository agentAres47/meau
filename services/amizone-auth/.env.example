PORT=8080

# Supabase — service role key is used to create the verified profile row.
# NEVER put the service role key in the app bundle; server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Amizone verification.
# MOCK_AMIZONE=true accepts any non-empty credentials except password "wrong"
# (which returns 401), so onboarding is testable without a real Amizone account.
# Real verification (MOCK_AMIZONE=false) is not implemented yet and throws —
# Amizone is behind Cloudflare; see AMIZONE-CLOUDFLARE-REALITY.md. Keep this true.
MOCK_AMIZONE=true
